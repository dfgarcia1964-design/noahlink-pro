{
  "name": "noahlink-pro-desktop",
  "version": "0.1.0",
  "description": "Desktop App (Electron) para NoahLink Pro - Control de audífonos Phonak",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3001 && npm run electron-start\"",
    "react-start": "cross-env PORT=3001 react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron public/electron.js",
    "electron-build": "npm run react-build && electron-builder",
    "build": "npm run react-build && npm run electron-build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "http-proxy-middleware": "^2.0.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "recharts": "^2.10.0",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "concurrently": "^8.2.1",
    "cross-env": "^10.1.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "electron-devtools-installer": "^3.2.0",
    "wait-on": "^7.0.1"
  },
  "proxy": "http://localhost:3000",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.noahlink.pro",
    "productName": "NoahLink Pro",
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
