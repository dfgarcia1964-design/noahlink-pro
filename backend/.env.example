# Backend Configuration

# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database MongoDB
MONGODB_URI=mongodb://localhost:27017/noahlink-pro

# Legacy PostgreSQL (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noahlink_pro
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Bluetooth
BLUETOOTH_SCAN_DURATION=10000
BLUETOOTH_RECONNECT_INTERVAL=5000
BLUETOOTH_RECONNECT_MAX_ATTEMPTS=5

# API
CORS_ORIGIN=http://localhost:3001
API_VERSION=v1

# WebSocket
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=60000

# Logging
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
